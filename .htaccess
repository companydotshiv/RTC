# ==============================================================================
# RTC Foods - Apache / LiteSpeed .htaccess Configuration for PHP Website
# ==============================================================================

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve existing physical files directly (images, css, js, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Clean URL mappings for pages
  RewriteRule ^products/?$ products.php [L,QSA]
  RewriteRule ^product/([^/]+)/?$ product.php?slug=$1 [L,QSA]
  RewriteRule ^cart/?$ cart.php [L,QSA]
  RewriteRule ^checkout/?$ checkout.php [L,QSA]
  RewriteRule ^order-confirmation/?$ order-confirmation.php [L,QSA]
  RewriteRule ^wishlist/?$ wishlist.php [L,QSA]
  RewriteRule ^account/?$ account.php [L,QSA]
  RewriteRule ^my-account/?$ account.php [L,QSA]
  RewriteRule ^about-us/?$ about-us.php [L,QSA]
  RewriteRule ^about/?$ about-us.php [L,QSA]
  RewriteRule ^certificates/?$ certificates.php [L,QSA]
  RewriteRule ^certificate/?$ certificates.php [L,QSA]
  RewriteRule ^faqs/?$ faqs.php [L,QSA]
  RewriteRule ^faq/?$ faqs.php [L,QSA]
  RewriteRule ^blog/?$ blog.php [L,QSA]
  RewriteRule ^blog/([^/]+)/?$ blog-post.php?slug=$1 [L,QSA]
  RewriteRule ^contact-us/?$ contact-us.php [L,QSA]
  RewriteRule ^contact/?$ contact-us.php [L,QSA]

  # Legal Policy mappings
  RewriteRule ^shipping-policy/?$ policy.php?type=shipping [L,QSA]
  RewriteRule ^privacy-policy/?$ policy.php?type=privacy [L,QSA]
  RewriteRule ^returns-policy/?$ policy.php?type=returns [L,QSA]
  RewriteRule ^terms-conditions/?$ policy.php?type=terms [L,QSA]

  # Admin
  RewriteRule ^admin/?$ admin/index.php [L,QSA]
</IfModule>

# ==============================================================================
# Performance & GZIP / Brotli Compression
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==============================================================================
# Browser Caching Headers
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# ==============================================================================
# Security Headers
# ==============================================================================
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
